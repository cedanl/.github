/* Npuls web-laag v@@VERSION@@ - waarden komen uit vormgever-npuls-huisstijl/references/design-tokens.json */
/* General Sans (Fontshare) met Plus Jakarta Sans als digitale vervanger. Cooper Light: lokaal installeren, zie ../fonts.md */
@import url('https://api.fontshare.com/v2/css?f[]=general-sans@400,600&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

:root {
@@ROOT@@
}

/* Aliassen voor cedapress-decks (frame.html): korte namen op de tokens hierboven */
:root {
  --licht-groen: var(--npuls-licht-groen); --licht-blauw: var(--npuls-licht-blauw); --licht-roze: var(--npuls-licht-roze);
  --licht-oranje: var(--npuls-licht-oranje); --licht-geel: var(--npuls-licht-geel);
  --font-primair: var(--npuls-font-primary); --font-secundair: var(--npuls-font-secondary);
}

body { font-family: var(--npuls-font-primary); font-size: var(--npuls-body); font-weight: 400; color: var(--npuls-zwart); }
h1, h2, h3 { font-weight: 600; margin: 0 0 var(--npuls-space-md); }
h1 { font-size: var(--npuls-h1); } h2 { font-size: var(--npuls-h2); } h3 { font-size: var(--npuls-h3); }
.npuls-label { font-size: var(--npuls-label); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
.npuls-intro, .npuls-quote { font-family: var(--npuls-font-secondary); font-weight: 300; }

/* Toegestane kleurcombinaties (allowed_combinations). Zwart nooit als achtergrond.
   Gebruik: class="bg-blauw fg-geel". Verboden: geel-op-groen, groen-op-blauw. */
@@COMBINATIES@@

/* Decks: class="npuls-slide" op de slide */
.npuls-slide { position: relative; overflow: hidden; font-family: var(--npuls-font-primary); }
/* Logo linksboven: <img class="npuls-logo" src="logos/npuls-logo-horizontaal-zwart.png" alt="Npuls"> (wit op blauw/groen/oranje) */
.npuls-logo { position: absolute; top: 3%; left: 3%; height: 6%; width: auto; }
/* Bogen rechtsonder: <img class="npuls-bogen" src="vormen/bogen.svg" alt=""> */
.npuls-bogen { position: absolute; right: 0; bottom: 0; height: 45%; width: auto; pointer-events: none; }
